    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/ourairports-mcp-server#readme",
  "repository": "https://github.com/cyanheads/ourairports-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "ourairports",
    "aviation",
    "airport",
    "airports",
    "iata",
    "icao",
    "navaid",
    "runway",
    "geospatial"
  ]
}
